{
  "name": "poplens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:setup": "tsx scripts/db-setup.ts",
    "seed": "tsx scripts/seed.ts",
    "load:grid3": "tsx scripts/load-grid3.ts",
    "load:population": "tsx scripts/population-grid.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@hookform/resolvers": "^5.0.0",
    "@react-pdf/renderer": "^4.3.0",
    "@tanstack/react-table": "^8.21.0",
    "@turf/turf": "^7.2.0",
    "better-auth": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.510.0",
    "maplibre-gl": "^5.6.0",
    "next": "16.4.0",
    "papaparse": "^5.5.0",
    "pg": "^8.16.0",
    "pg-boss": "^10.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.56.0",
    "react-map-gl": "^8.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/turbopack": "^4",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5",
    "vitest": "^3.1.0"
  },
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "patchedDependencies": {
      "@react-pdf/hyphenate@0.1.0": "patches/@react-pdf__hyphenate@0.1.0.patch"
    }
  }
}
